<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="audit_snapshot_view_list" model="ir.ui.view">
        <field name="name">audit.snapshot.list</field>
        <field name="model">audit.snapshot</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="entity_count"/>
                <field name="field_count"/>
                <field name="storage_size"/>
            </tree>
        </field>
    </record>

    <record id="audit_snapshot_view_form" model="ir.ui.view">
        <field name="name">audit.snapshot.form</field>
        <field name="model">audit.snapshot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compare" type="object" string="Comparer à l'état actuel"
                            class="btn-primary" invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="text-muted" invisible="id">
                        L'instance est prise à l'enregistrement : elle garde la structure des entités qui ont
                        une configuration à ce moment-là.
                    </div>
                    <group invisible="not id">
                        <group string="Instance">
                            <field name="date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Contenu et place occupée">
                            <field name="entity_count"/>
                            <field name="field_count"/>
                            <field name="storage_size"/>
                            <field name="storage_bytes" optional="hide"/>
                        </group>
                    </group>
                    <notebook invisible="not id">
                        <page string="Entités" name="entities">
                            <field name="entity_ids">
                                <tree>
                                    <field name="model_label"/>
                                    <field name="model_name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Champs" name="fields">
                            <field name="field_ids">
                                <tree>
                                    <field name="model_name"/>
                                    <field name="field_name"/>
                                    <field name="label"/>
                                    <field name="ttype"/>
                                    <field name="required" optional="hide"/>
                                    <field name="readonly" optional="hide"/>
                                    <field name="stored" optional="hide"/>
                                    <field name="relation" optional="show"/>
                                    <field name="selection" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_audit_snapshot" model="ir.actions.act_window">
        <field name="name">Instances</field>
        <field name="res_model">audit.snapshot</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune instance</p>
            <p>Une instance garde la structure actuelle des entités auditées, pour la comparer plus tard.</p>
        </field>
    </record>

    <record id="audit_snapshot_diff_view_list" model="ir.ui.view">
        <field name="name">audit.snapshot.diff.list</field>
        <field name="model">audit.snapshot.diff</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0"
                  decoration-success="kind in ('entity_added', 'field_added')"
                  decoration-danger="kind in ('entity_removed', 'model_deleted', 'field_removed')"
                  decoration-warning="kind == 'field_changed'">
                <field name="model_label"/>
                <field name="model_name" optional="hide"/>
                <field name="kind"/>
                <field name="field_name"/>
                <field name="attribute"/>
                <field name="old_value"/>
                <field name="new_value"/>
            </tree>
        </field>
    </record>

    <record id="audit_snapshot_diff_view_search" model="ir.ui.view">
        <field name="name">audit.snapshot.diff.search</field>
        <field name="model">audit.snapshot.diff</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_label"/>
                <field name="field_name"/>
                <filter name="added" string="Ajouts" domain="[('kind', 'in', ('entity_added', 'field_added'))]"/>
                <filter name="removed" string="Suppressions"
                        domain="[('kind', 'in', ('entity_removed', 'model_deleted', 'field_removed'))]"/>
                <filter name="changed" string="Modifications" domain="[('kind', '=', 'field_changed')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_model" string="Entité" context="{'group_by': 'model_label'}"/>
                    <filter name="group_kind" string="Type de différence" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
