<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="audit_purge_wizard_view_form" model="ir.ui.view">
        <field name="name">audit.purge.wizard.form</field>
        <field name="model">audit.purge.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    Les entrées du journal plus anciennes que la date choisie seront supprimées avec leurs détails.
                    Une trace de la purge est conservée de façon permanente.
                </p>
                <group>
                    <field name="cutoff"/>
                    <field name="entries_count"/>
                </group>
                <footer>
                    <button string="Purger" type="object" name="action_purge" class="btn-danger"
                            confirm="Cette action est irréversible. Supprimer définitivement ces entrées du journal ?"
                            invisible="entries_count == 0"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_audit_purge_wizard" model="ir.actions.act_window">
        <field name="name">Purger le journal</field>
        <field name="res_model">audit.purge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('group_audit_admin'))]"/>
    </record>

    <record id="audit_purge_view_list" model="ir.ui.view">
        <field name="name">audit.purge.list</field>
        <field name="model">audit.purge</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <header>
                    <button name="%(action_audit_purge_wizard)d" type="action"
                            string="Purger les logs" display="always" class="btn-danger"/>
                </header>
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="cutoff"/>
                <field name="entries_count"/>
            </tree>
        </field>
    </record>

    <record id="audit_purge_view_form" model="ir.ui.view">
        <field name="name">audit.purge.form</field>
        <field name="model">audit.purge</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="cutoff"/>
                            <field name="entries_count"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_audit_purge" model="ir.actions.act_window">
        <field name="name">Historique des purges</field>
        <field name="res_model">audit.purge</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune purge effectuée</p>
            <p>Chaque purge du journal laisse ici une trace permanente.</p>
        </field>
    </record>
</odoo>
