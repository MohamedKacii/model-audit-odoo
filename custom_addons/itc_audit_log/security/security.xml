<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_audit" model="ir.module.category">
        <field name="name">Model auditer</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_audit_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="category_id" ref="module_category_audit"/>
        <field name="comment">Peut consulter le journal des opérations et la configuration, sans rien modifier.</field>
    </record>

    <record id="group_audit_admin" model="res.groups">
        <field name="name">Administrateur</field>
        <field name="category_id" ref="module_category_audit"/>
        <field name="implied_ids" eval="[(4, ref('group_audit_user'))]"/>
        <field name="comment">Peut en plus créer et modifier la configuration de traçabilité.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
